// Main module that imports others
import "tests/module/mod_a.zt" as a;
import "tests/module/mod_b.zt" as b;
import "tests/module/mod_c.zt";

fn main() {
    var pass = 0;
    var fail = 0;

    // Using imported function via alias
    if (a.add(1, 2) == 3) { pass = pass + 1; } else { print("FAIL: import alias function\n"); fail = fail + 1; }
    if (a.multiply(3, 4) == 12) { pass = pass + 1; } else { print("FAIL: import alias multiply\n"); fail = fail + 1; }

    // Using imported constant
    if (a.PI > 3.14 && a.PI < 3.142) { pass = pass + 1; } else { print("FAIL: import constant\n"); fail = fail + 1; }

    // Using module that depends on another module
    // b.circle_area uses a.PI and a.multiply
    var area = b.circle_area(10);
    if (area == 314.159) { pass = pass + 1; } else { print("FAIL: transitive import\n"); fail = fail + 1; }

    // Shared mutable state through import
    var c1 = b.increment_counter();
    var c2 = b.increment_counter();
    if (c1 == 1 && c2 == 2) { pass = pass + 1; } else { print("FAIL: shared mutable import\n"); fail = fail + 1; }

    // Import without alias
    var s = Shape("circle");
    if (s.describe() == "Shape: circle") { pass = pass + 1; } else { print("FAIL: import class\n"); fail = fail + 1; }

    print("module: ");
    print(pass);
    print("/");
    print(pass + fail);
    print(" passed\n");
    return 0;
}
