fn factorial(n) {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

fn fibonacci(n) {
    if (n <= 1) {
        return n;
    }
    return fibonacci(n - 1) + fibonacci(n - 2);
}

fn sum_list(arr, idx, len) {
    if (idx >= len) {
        return 0;
    }
    return arr[idx] + sum_list(arr, idx + 1, len);
}

fn main() {
    // factorial
    assert(factorial(0) == 1);
    assert(factorial(1) == 1);
    assert(factorial(5) == 120);

    // fibonacci
    assert(fibonacci(0) == 0);
    assert(fibonacci(1) == 1);
    assert(fibonacci(6) == 8);

    // recursive array sum
    var arr = [1, 2, 3, 4, 5];
    assert(sum_list(arr, 0, 5) == 15);

    print("recursion: all passed\n");
    return 0;
}
