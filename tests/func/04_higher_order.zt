fn map_(arr, f) {
    var result = array(arr.size());
    var i = 0;
    while (i < arr.size()) {
        result[i] = f(arr[i]);
        i = i + 1;
    }
    return result;
}

fn filter(arr, pred) {
    var result = array(0);
    var i = 0;
    while (i < arr.size()) {
        if (pred(arr[i])) {
            result.add(arr[i]);
        }
        i = i + 1;
    }
    return result;
}

fn reduce(arr, f, init) {
    var acc = init;
    var i = 0;
    while (i < arr.size()) {
        acc = f(acc, arr[i]);
        i = i + 1;
    }
    return acc;
}

fn main() {
    // map
    var doubled = map_([1, 2, 3], fn(x) { return x * 2; });
    assert(doubled[0] == 2 && doubled[1] == 4 && doubled[2] == 6);

    // filter
    var evens = filter([1, 2, 3, 4, 5, 6], fn(x) { return x % 2 == 0; });
    assert(evens.size() == 3 && evens[0] == 2 && evens[1] == 4 && evens[2] == 6);

    // reduce
    var sum = reduce([1, 2, 3, 4, 5], fn(a, b) { return a + b; }, 0);
    assert(sum == 15);

    var product = reduce([1, 2, 3, 4], fn(a, b) { return a * b; }, 1);
    assert(product == 24);

    // empty filter
    var empty = filter([1, 3, 5], fn(x) { return x % 2 == 0; });
    assert(empty.size() == 0);

    print("higher_order: all passed\n");
    return 0;
}
