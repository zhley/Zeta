fn add(a, b) {
    return a + b;
}

fn identity(x) {
    return x;
}

fn greet(name) {
    return "Hello, " + name;
}

fn sum_to_n(n) {
    var total = 0;
    var i = 1;
    while (i <= n) {
        total = total + i;
        i = i + 1;
    }
    return total;
}

fn main() {
    // basic call
    assert(add(1, 2) == 3);
    assert(add(-1, 5) == 4);

    // identity
    assert(identity(42) == 42);
    assert(identity("x") == "x");
    assert(identity(true) == true);
    assert(identity(null) == null);

    // string return
    var g = greet("World");
    assert(g == "Hello, World");

    // sum
    assert(sum_to_n(5) == 15);
    assert(sum_to_n(1) == 1);
    assert(sum_to_n(0) == 0);

    print("func_basic: all passed\n");
    return 0;
}
