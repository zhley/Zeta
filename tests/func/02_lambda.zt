fn main() {
    // function literal assigned to variable
    var double = fn(x) { return x * 2; };
    assert(double(5) == 10);

    // lambda with no parameters
    var getOne = fn() { return 1; };
    assert(getOne() == 1);

    // lambda with multiple parameters
    var mul = fn(a, b) { return a * b; };
    assert(mul(6, 7) == 42);

    // NOTE: currently no closure support, so lambdas can only access
    // their parameters and globals, not enclosing local variables.

    // passing lambda as argument
    var apply = fn (f, x) {
        return f(x);
    };
    assert(apply(fn(y) { return y + 1; }, 10) == 11);

    // lambda returning lambda (higher-order)
    var make_adder = fn(n) {
        return fn(x) { return x; };
    };
    var add3 = make_adder(3);
    assert(add3(7) == 7);

    print("lambda: all passed\n");
    return 0;
}
