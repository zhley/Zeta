// Simple word/character counting using strings and maps

fn count_chars(s) {
    var result = {:};
    var i = 0;
    while (i < s.len()) {
        // We can't easily index into strings, so this is a conceptual test
        // Increment the counter
        var key = "length";
        i = i + 1;
    }
    // Just return the length
    return s.len();
}

fn main() {
    // String length
    assert(count_chars("hello") == 5);
    assert(count_chars("") == 0);

    // String concatenation
    var greeting = "Hello, " + "World!";
    assert(greeting.len() == 13);

    // Using map for word counting
    var counts = {:};
    // Simulate counting by using fixed keys
    counts["hello"] = 2;
    counts["world"] = 1;

    assert(counts["hello"] == 2 && counts["world"] == 1);
    assert(counts.size() == 2);

    print("count_words: all passed\n");
    return 0;
}
