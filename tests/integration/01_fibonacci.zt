// Iterative and recursive fibonacci implementations

fn fib_iterative(n) {
    if (n <= 1) {
        return n;
    }
    var a = 0;
    var b = 1;
    var i = 2;
    while (i <= n) {
        var temp = a + b;
        a = b;
        b = temp;
        i = i + 1;
    }
    return b;
}

fn fib_recursive(n) {
    if (n <= 1) {
        return n;
    }
    return fib_recursive(n - 1) + fib_recursive(n - 2);
}

fn main() {
    // fib(0) and fib(1)
    assert(fib_iterative(0) == 0);
    assert(fib_iterative(1) == 1);
    assert(fib_recursive(0) == 0);
    assert(fib_recursive(1) == 1);

    // fib(10) = 55
    assert(fib_iterative(10) == 55);
    assert(fib_recursive(10) == 55);

    // both methods agree
    var n = 15;
    assert(fib_iterative(n) == fib_recursive(n));

    print("fibonacci: all passed\n");
    return 0;
}
