// Bubble sort implementation

fn bubble_sort(arr) {
    var n = arr.size();
    var i = 0;
    while (i < n) {
        var j = 0;
        while (j < n - i - 1) {
            if (arr[j] > arr[j + 1]) {
                var temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return arr;
}

fn is_sorted(arr) {
    var i = 0;
    while (i < arr.size() - 1) {
        if (arr[i] > arr[i + 1]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn main() {
    var pass = 0;
    var fail = 0;

    // sort already sorted array
    var sorted = bubble_sort([1, 2, 3, 4, 5]);
    if (is_sorted(sorted)) { pass = pass + 1; } else { print("FAIL: sort sorted\n"); fail = fail + 1; }

    // sort reverse array
    var rev = bubble_sort([5, 4, 3, 2, 1]);
    if (is_sorted(rev) && rev[0] == 1 && rev[4] == 5) {
        pass = pass + 1;
    } else {
        print("FAIL: sort reversed\n");
        fail = fail + 1;
    }

    // sort with duplicates
    var dup = bubble_sort([3, 1, 2, 1, 3]);
    if (is_sorted(dup) && dup[0] == 1 && dup[4] == 3) {
        pass = pass + 1;
    } else {
        print("FAIL: sort duplicates\n");
        fail = fail + 1;
    }

    // empty array
    var empty = bubble_sort([]);
    if (is_sorted(empty) && empty.size() == 0) { pass = pass + 1; } else { print("FAIL: sort empty\n"); fail = fail + 1; }

    // single element
    var one = bubble_sort([42]);
    if (is_sorted(one) && one[0] == 42) { pass = pass + 1; } else { print("FAIL: sort single\n"); fail = fail + 1; }

    print("sort: ");
    print(pass);
    print("/");
    print(pass + fail);
    print(" passed\n");
    return 0;
}
