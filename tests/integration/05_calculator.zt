// Simple expression-like calculator using various language features

class Calculator {
    var value = 0;

    fn _init(init) {
        this.value = init;
        return this;
    }

    fn add(n) {
        this.value = this.value + n;
        return this;
    }

    fn sub(n) {
        this.value = this.value - n;
        return this;
    }

    fn mul(n) {
        this.value = this.value * n;
        return this;
    }

    fn div(n) {
        this.value = this.value / n;
        return this;
    }

    fn result() {
        return this.value;
    }
}

fn main() {
    // method chaining
    var result = Calculator(0).add(10).mul(3).sub(5).div(5).result();
    assert(result == 5);

    // another computation
    var r2 = Calculator(100).add(50).sub(30).result();
    assert(r2 == 120);

    // using a function that processes an array of operations
    var process_ops = fn (init, ops) {
        var calc = Calculator(init);
        for (op : ops) {
            // op contains value only, add it
            calc.add(op.value);
        }
        return calc.result();
    };

    // Array of operation-like objects (just values)
    var arr = [10, 20, 30];
    var sum = 0;
    for (v : arr) {
        sum = sum + v;
    }
    assert(sum == 60);

    print("calculator: all passed\n");
    return 0;
}
