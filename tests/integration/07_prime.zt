// Sieve of Eratosthenes: arrays + nested loops

fn sieve(n) {
    var is_prime = array(n + 1);
    var i = 2;
    while (i <= n) {
        is_prime[i] = true;
        i = i + 1;
    }
    i = 2;
    while (i * i <= n) {
        if (is_prime[i]) {
            var j = i * i;
            while (j <= n) {
                is_prime[j] = false;
                j = j + i;
            }
        }
        i = i + 1;
    }
    return is_prime;
}

fn main() {
    var primes = sieve(30);

    // primes up to 30
    assert(primes[2] == true);
    assert(primes[3] == true);
    assert(primes[5] == true);
    assert(primes[7] == true);
    assert(primes[11] == true);
    assert(primes[13] == true);
    assert(primes[17] == true);
    assert(primes[19] == true);
    assert(primes[23] == true);
    assert(primes[29] == true);

    // composites
    assert(primes[4] == false);
    assert(primes[9] == false);
    assert(primes[15] == false);
    assert(primes[21] == false);
    assert(primes[25] == false);
    assert(primes[27] == false);

    // 0 and 1 were never touched: default null (not true)
    assert(primes[0] != true);
    assert(primes[1] != true);

    // small cases
    var p2 = sieve(2);
    assert(p2[2] == true);
    var p1 = sieve(1);
    assert(p1[1] != true);

    print("prime: all passed\n");
    return 0;
}
