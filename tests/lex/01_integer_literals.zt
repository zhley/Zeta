fn main() {
    // decimal
    assert(0 == 0);
    assert(42 == 42);
    assert(1_000_000 == 1000000);

    // hexadecimal
    assert(0xFF == 255);
    assert(0X1A == 26);
    assert(0x0 == 0);

    // binary
    assert(0b1010 == 10);
    assert(0B1111 == 15);
    assert(0b10_10 == 10);

    // octal
    assert(0o777 == 511);
    assert(0o10 == 8);

    // negative numbers
    assert(-42 == -42);

    print("integer_literals: all passed\n");
    return 0;
}
