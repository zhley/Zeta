fn main() {
    // bool literals
    assert(true == true);
    assert(false == false);
    assert(true != false);

    // not operator on bool
    assert(!true == false);
    assert(!false == true);

    // null literal
    assert(null == null);
    assert(null != true);

    // truthiness: null is falsey
    assert(!null == true);

    print("bool_null: all passed\n");
    return 0;
}
