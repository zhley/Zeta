fn main() {
    // double-quoted strings
    assert("hello" == "hello");
    assert("" == "");

    // single-quoted strings
    assert('world' == 'world');
    assert('x' == 'x');

    // escape sequences
    assert("\n" == "\n");
    assert("\t" == "\t");
    assert("\\" == "\\");
    assert("\"" == "\"");
    assert("\'" == "\'");
    assert("\r" == "\r");

    // string length
    assert("abc".len() == 3);
    assert("".len() == 0);
    assert("你好".len() != 0);

    print("string_literals: all passed\n");
    return 0;
}
