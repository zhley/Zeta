fn main() {
    // basic floats
    assert(3.14 == 3.14);
    assert(0.5 == 0.5);
    assert(0.0 == 0.0);

    // with exponent
    assert(1.0e10 == 10000000000.0);
    assert(2.5e-3 == 0.0025);
    assert(1e5 == 100000.0);

    // with separators
    assert(1_000.5 == 1000.5);

    // negative
    assert(-3.14 == -3.14);

    print("float_literals: all passed\n");
    return 0;
}
