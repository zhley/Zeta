fn main() {
    // basic while loop
    var sum = 0;
    var i = 1;
    while (i <= 5) {
        sum = sum + i;
        i = i + 1;
    }
    assert(sum == 15);

    // while with false condition (zero iterations)
    var count = 0;
    while (false) {
        count = count + 1;
    }
    assert(count == 0);

    // while with 0 as condition (zero iterations)
    count = 0;
    while (0) {
        count = count + 1;
    }
    assert(count == 0);

    // nested while loops
    var row = 0;
    var total = 0;
    while (row < 3) {
        var col = 0;
        while (col < 3) {
            total = total + 1;
            col = col + 1;
        }
        row = row + 1;
    }
    assert(total == 9);

    print("while: all passed\n");
    return 0;
}
