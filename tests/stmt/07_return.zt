fn early_return(x) {
    if (x > 0) {
        return x;
    }
    return 0;
}

fn no_return_value() {
    // implicit return null
}

fn return_null_explicitly() {
    return;
}

fn main() {
    // return with value
    assert(early_return(5) == 5);
    assert(early_return(-1) == 0);

    // return with no value (implicit null)
    assert(no_return_value() == null);
    assert(return_null_explicitly() == null);

    // multiple return paths
    assert(early_return(10) == 10 && early_return(0) == 0);

    print("return: all passed\n");
    return 0;
}
