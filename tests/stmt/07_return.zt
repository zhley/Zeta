fn early_return(x) {
    if (x > 0) {
        return x;
    }
    return 0;
}

fn no_return_value() {
    // implicit return null
}

fn return_null_explicitly() {
    return;
}

fn main() {
    var pass = 0;
    var fail = 0;

    // return with value
    if (early_return(5) == 5) { pass = pass + 1; } else { print("FAIL: return value\n"); fail = fail + 1; }
    if (early_return(-1) == 0) { pass = pass + 1; } else { print("FAIL: return 0\n"); fail = fail + 1; }

    // return with no value (implicit null)
    if (no_return_value() == null) { pass = pass + 1; } else { print("FAIL: implicit return null\n"); fail = fail + 1; }
    if (return_null_explicitly() == null) { pass = pass + 1; } else { print("FAIL: explicit return;\n"); fail = fail + 1; }

    // multiple return paths
    if (early_return(10) == 10 && early_return(0) == 0) { pass = pass + 1; } else { print("FAIL: multiple returns\n"); fail = fail + 1; }

    print("return: ");
    print(pass);
    print("/");
    print(pass + fail);
    print(" passed\n");
    return 0;
}
