fn main() {
    // if with true condition
    var r = "none";
    if (true) {
        r = "then";
    }
    assert(r == "then");

    // if with false condition
    r = "none";
    if (false) {
        r = "then";
    }
    assert(r == "none");

    // if-else true
    r = "none";
    if (true) {
        r = "then";
    } else {
        r = "else";
    }
    assert(r == "then");

    // if-else false
    r = "none";
    if (false) {
        r = "then";
    } else {
        r = "else";
    }
    assert(r == "else");

    // nested if
    r = "none";
    if (true) {
        if (false) {
            r = "inner-then";
        } else {
            r = "inner-else";
        }
    }
    assert(r == "inner-else");

    // if with truthiness: non-zero int
    r = "none";
    if (1) { r = "yes"; }
    assert(r == "yes");

    // if with truthiness: 0 is falsey
    r = "none";
    if (0) { r = "yes"; }
    assert(r == "none");

    // if with null is falsey
    r = "none";
    if (null) { r = "yes"; }
    assert(r == "none");

    // dangling-else: else binds to nearest if
    r = "none";
    if (true)
        if (false)
            r = "inner";
        else
            r = "dangling";
    assert(r == "dangling");

    print("if_else: all passed\n");
    return 0;
}
