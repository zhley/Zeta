fn main() {
    // var declaration without initializer (defaults to null)
    var x;
    assert(x == null);

    // var with initializer
    var y = 42;
    assert(y == 42);

    // let (immutable) with initializer
    let z = "hello";
    assert(z == "hello");

    // multiple var declarations in one statement
    var a = 1, b = 2, c = 3;
    assert(a == 1 && b == 2 && c == 3);

    // var is mutable
    var m = 10;
    m = 20;
    assert(m == 20);

    // mixed var and value types
    var i = 10;
    var f = 3.14;
    var s = "test";
    b = true;
    var n = null;
    assert(i == 10 && f == 3.14 && s == "test" && b == true && n == null);

    print("var_let: all passed\n");
    return 0;
}
