fn main() {
    // simple assignment
    var x = 0;
    x = 42;
    assert(x == 42);

    // AddAssign
    var a = 10;
    a += 5;
    assert(a == 15);

    // SubAssign
    a -= 3;
    assert(a == 12);

    // MulAssign
    a *= 2;
    assert(a == 24);

    // DivAssign
    a /= 3;
    assert(a == 8);

    // ModAssign
    a %= 5;
    assert(a == 3);

    // BitAndAssign
    var ba = 0xFF;
    ba &= 0x0F;
    assert(ba == 15);

    // BitOrAssign
    var bo = 0xF0;
    bo |= 0x0F;
    assert(bo == 255);

    // BitXorAssign
    var bx = 0xFF;
    bx ^= 0xFF;
    assert(bx == 0);

    // ShlAssign
    var sl = 1;
    sl <<= 4;
    assert(sl == 16);

    // ShrAssign
    var sr = 16;
    sr >>= 2;
    assert(sr == 4);

    print("assignment: all passed\n");
    return 0;
}
