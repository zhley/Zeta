fn main() {
    // block creates a new scope
    var outer = 1;
    {
        var inner = 2;
        assert(inner == 2);
        // can access outer from inner
        assert(outer == 1);
    }
    // outer should still be 1
    assert(outer == 1);

    // variable shadowing: inner var shadows outer with same name
    var x = "outer";
    {
        var x = "inner";
        assert(x == "inner");
    }
    assert(x == "outer");

    // nested blocks
    {
        var a = 1;
        {
            var b = 2;
            assert(a + b == 3);
        }
    }

    // if body is a block (creates scope)
    if (true) {
        var in_if = "yes";
        assert(in_if == "yes");
    }

    // while body is a block
    var count = 0;
    while (count < 3) {
        var w = count;
        count = count + 1;
    }
    assert(count == 3);

    print("block_scope: all passed\n");
    return 0;
}
