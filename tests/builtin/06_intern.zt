fn main() {
    var s1 = "hel";
    // intern a concatenated string
    var concat = s1 + "lo";
    var interned = intern(concat);
    // interned string is a String (interned), equal to literal
    assert(interned == "hello");
    assert(interned is "hello");

    // can use interned string as map key
    var m = {hello: 42};
    assert(m[interned] == 42);

    // StrObj can't be used as map key (would need different key)
    // Just verify the intern doesn't crash
    var s2 = "a";
    s2 = s2 + "b";
    var i2 = intern(s2);
    assert(i2 == "ab");

    print("intern: all passed\n");
    return 0;
}
