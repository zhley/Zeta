fn main() {
    var pass = 0;
    var fail = 0;

    // print null
    print("print_null: ");
    print("expect(null)=<");
    print(null);
    print(">\n");
    pass = pass + 1;

    // print bool
    print("print_bool: ");
    print("expect(true)=<");
    print(true);
    print("> expect(false)=<");
    print(false);
    print(">\n");
    pass = pass + 1;

    // print int
    print("print_int: ");
    print("expect(42)=<");
    print(42);
    print(">\n");
    pass = pass + 1;

    // print float
    print("print_float: ");
    print("expect(3.14)=<");
    print(3.14);
    print(">\n");
    pass = pass + 1;

    // print string
    print("print_str: ");
    print("expect(hello)=<");
    print("hello");
    print(">\n");
    pass = pass + 1;

    // print array
    print("print_array: ");
    print("expect(<array>)=<");
    print([1, 2]);
    print(">\n");
    pass = pass + 1;

    // print map
    print("print_map: ");
    print("expect(<map>)=<");
    print({a: 1});
    print(">\n");
    pass = pass + 1;

    // print function
    print("print_fn: ");
    print("expect(<function>)=<");
    print(fn(){});
    print(">\n");
    pass = pass + 1;

    print("print: ");
    print(pass);
    print("/");
    print(pass + fail);
    print(" passed\n");
    return 0;
}
