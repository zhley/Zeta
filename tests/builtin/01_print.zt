fn main() {
    // Verifies the exact output of print(). The runner diffs this test's
    // output against tests/builtin/01_print.expected (see tests/test.sh).

    // print null
    print("print_null: ");
    print("expect(null)=<");
    print(null);
    print(">\n");

    // print bool
    print("print_bool: ");
    print("expect(true)=<");
    print(true);
    print("> expect(false)=<");
    print(false);
    print(">\n");

    // print int
    print("print_int: ");
    print("expect(42)=<");
    print(42);
    print(">\n");

    // print float
    print("print_float: ");
    print("expect(3.14)=<");
    print(3.14);
    print(">\n");

    // print string
    print("print_str: ");
    print("expect(hello)=<");
    print("hello");
    print(">\n");

    // print array
    print("print_array: ");
    print("expect(<array>)=<");
    print([1, 2]);
    print(">\n");

    // print map
    print("print_map: ");
    print("expect(<map>)=<");
    print({a: 1});
    print(">\n");

    // print function
    print("print_fn: ");
    print("expect(<function>)=<");
    print(fn(){});
    print(">\n");

    print("print: all passed\n");
    return 0;
}
