fn main() {
    // array creation with literal
    var arr = [10, 20, 30];
    assert(arr[0] == 10 && arr[1] == 20 && arr[2] == 30);

    // array creation via built-in
    var arr2 = array(3);
    arr2[0] = 100;
    arr2[1] = 200;
    arr2[2] = 300;
    assert(arr2[0] == 100 && arr2[1] == 200 && arr2[2] == 300);

    // array default values are null
    var arr3 = array(2);
    assert(arr3[0] == null && arr3[1] == null);

    // array.size() method
    assert(arr.size() == 3);
    var empty = [];
    assert(empty.size() == 0);

    // array.add() method
    arr.add(40);
    assert(arr.size() == 4 && arr[3] == 40);

    // add to empty array
    empty.add("first");
    assert(empty.size() == 1 && empty[0] == "first");

    // mixed element types
    var mixed = [1, "two", 3.0, true, null];
    assert(mixed[0] == 1 && mixed[1] == "two" && mixed[3] == true && mixed[4] == null);

    // array literal for-in
    var sum = 0;
    for (item : [1, 2, 3, 4]) {
        sum = sum + item;
    }
    assert(sum == 10);

    print("array: all passed\n");
    return 0;
}
