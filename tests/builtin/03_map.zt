fn main() {
    // map literal
    var m = {name: "Alice", age: 30};
    assert(m["name"] == "Alice" && m["age"] == 30);

    // map creation via built-in
    var m2 = map(4);
    m2["key1"] = "val1";
    m2["key2"] = "val2";
    assert(m2["key1"] == "val1" && m2["key2"] == "val2");

    // map.size()
    assert(m.size() == 2);
    var empty = {:};
    assert(empty.size() == 0);

    // map update value
    m["name"] = "Bob";
    assert(m["name"] == "Bob");
    assert(m["age"] == 30);

    // map with various value types
    var vt = {
        i: 1,
        f: 1.5,
        s: "hello",
        b: true,
        n: null
    };
    assert(vt["i"] == 1 && vt["f"] == 1.5 && vt["s"] == "hello" && vt["b"] == true && vt["n"] == null);

    // map iteration (keys)
    var count = 0;
    for (key : m) {
        count = count + 1;
    }
    assert(count == 2);

    // StrObj access
    var m3 = {greeting: "hi"};
    var s = "greet";
    var str_obj = s + "ing"; // creates a StrObj
    assert(m3[str_obj] == "hi");
    m3[str_obj] = "hello";
    assert(m3["greeting"] == "hello");

    print("map: all passed\n");
    return 0;
}
