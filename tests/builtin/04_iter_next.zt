fn main() {
    // iter on array
    var arr = [10, 20, 30];
    var it = iter(arr);

    // next on array
    var n1 = next(it);
    var n2 = next(it);
    var n3 = next(it);
    assert(n1 == 10 && n2 == 20 && n3 == 30);

    // 4th next returns Error
    var n4 = next(it);
    assert(check(n4) == false);

    // iter on map
    var m = {x: 100, y: 200};
    var mi = iter(m);
    var count = 0;
    var mk = next(mi);
    while (check(mk)) {
        count = count + 1;
        mk = next(mi);
    }
    assert(count == 2);

    // iter on empty array
    var empty = [];
    var ei = iter(empty);
    var en = next(ei);
    assert(check(en) == false);

    // iter on empty map
    var emptyMap = {:};
    var emi = iter(emptyMap);
    var emn = next(emi);
    assert(check(emn) == false);

    print("iter_next: all passed\n");
    return 0;
}
