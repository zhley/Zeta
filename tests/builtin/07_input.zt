fn main() {
    // Reads one line from stdin. The runner feeds a value automatically
    // (see tests/test.sh); "all passed" is only printed when input()
    // returned a non-null string, so a broken input() fails the check.
    print("Input test: type something and press enter\n");
    var s = input();
    print("You typed: ");
    print(s);
    print("\n");
    // verify StrObj basic operations
    if (s != null) {
        print("Input received (StrObj type, len=");
        print(s.len());
        print(")\n");
        print("input: all passed\n");
    }
    return 0;
}
