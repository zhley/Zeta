fn main() {
    // error with different codes
    var e1 = error(1);
    var e2 = error(2);
    var e0 = error(0);

    // check on Error returns false
    assert(check(e1) == false);
    assert(check(e2) == false);
    assert(check(e0) == false);

    // check on non-Error returns true
    assert(check(0) == true);
    assert(check(null) == true);
    assert(check("str") == true);
    assert(check(true) == true);
    assert(check([1, 2]) == true);

    // error values are not equal to each other
    assert(error(1) is error(1));

    // use check() with iter pattern to terminate a loop
    var arr = [1, 2, 3];
    var it = iter(arr);
    var sum = 0;
    var val = next(it);
    while (check(val)) {
        sum = sum + val;
        val = next(it);
    }
    assert(sum == 6);

    print("error_check: all passed\n");
    return 0;
}
