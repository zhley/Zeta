// Driven by cpp_interop_test; not run standalone.
// Zeta instantiates the C++-registered native class "NativePoint"
// and reads / writes its fields via native methods.
fn main() {
    var p = NativePoint();
    expect_eq(p.x, 1);
    expect_eq(p.y, 2);
    expect_eq(p.get_x(), 1);
    expect_eq(p.get_y(), 2);
    p.set_x(7);
    expect_eq(p.get_x(), 7);
    expect_eq(p.x, 7);
    return 0;
}
