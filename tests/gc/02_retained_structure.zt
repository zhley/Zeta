// GC: large retained structures (a linked list and a class-based tree)
// must survive many collection cycles interleaved with garbage allocation.

class Node {
    var value = 0;
    var next = null;
}

class TNode {
    var value = 0;
    var children = null; // array of TNode, null for leaves
}

fn churn(n) {
    var i = 0;
    while (i < n) {
        var a = [i, i + 1, i + 2, i + 3];
        var m = {x: i, y: str(i)};
        var s = "garbage-" + str(i);
        i = i + 1;
    }
}

fn build_list(n) {
    var head = null;
    var tail = null;
    var i = 0;
    while (i < n) {
        var node = Node();
        node.value = i;
        node.next = null;
        if (head == null) {
            head = node;
            tail = node;
        } else {
            tail.next = node;
            tail = node;
        }
        i = i + 1;
    }
    return head;
}

fn list_len(head) {
    var count = 0;
    var p = head;
    while (p != null) {
        count = count + 1;
        p = p.next;
    }
    return count;
}

fn list_sum(head) {
    var total = 0;
    var p = head;
    while (p != null) {
        total = total + p.value;
        p = p.next;
    }
    return total;
}

fn build_tree(depth, width, base) {
    var node = TNode();
    node.value = base;
    if (depth == 0) {
        node.children = null;
        return node;
    }
    var kids = array(width);
    var i = 0;
    while (i < width) {
        kids[i] = build_tree(depth - 1, width, base * 10 + i + 1);
        i = i + 1;
    }
    node.children = kids;
    return node;
}

fn tree_count(t) {
    if (t.children == null) {
        return 1;
    }
    var total = 1;
    for (c : t.children) {
        total = total + tree_count(c);
    }
    return total;
}

fn tree_find(t, v) {
    // NOTE: written with while instead of for-in + early return, because
    // "return" inside a for-in loop crashes the compiler (see tests/gc/02
    // notes in tests/README.md).
    if (t.value == v) {
        return true;
    }
    if (t.children == null) {
        return false;
    }
    var i = 0;
    while (i < t.children.size()) {
        if (tree_find(t.children[i], v)) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn main() {
    var head = build_list(500);
    var tree = build_tree(4, 3, 0);
    churn(30000);

    // the list survived: 500 nodes, values 0..499
    assert(list_len(head) == 500);
    assert(list_sum(head) == 124750);

    // the tree survived: 1 + 3 + 9 + 27 + 81 = 121 nodes
    assert(tree_count(tree) == 121);
    assert(tree.value == 0);
    assert(tree_find(tree, 1) && tree_find(tree, 3333) && tree_find(tree, 121));
    assert(!tree_find(tree, 1234));

    print("gc_retained_structure: all passed\n");
    return 0;
}
