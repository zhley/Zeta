class Vec3 {
    var x = 0;
    var y = 0;
    var z = 0;

    fn _init(vx, vy, vz) {
        this.x = vx;
        this.y = vy;
        this.z = vz;
        return this;
    }

    fn length_sq() {
        return this.x * this.x + this.y * this.y + this.z * this.z;
    }
}

class NoCtor {
    var a = 10;
    var b = 20;
}

fn main() {
    // constructor with arguments
    var v = Vec3(1, 2, 3);
    assert(v.x == 1 && v.y == 2 && v.z == 3);

    // method works after construction
    assert(v.length_sq() == 14);

    // no constructor: uses defaults
    var nc = NoCtor();
    assert(nc.a == 10 && nc.b == 20);

    // multiple instances via constructor
    var v1 = Vec3(1, 0, 0);
    var v2 = Vec3(0, 1, 0);
    assert(v1.x == 1 && v1.y == 0 && v2.x == 0 && v2.y == 1);

    print("constructor: all passed\n");
    return 0;
}
