class Range {
    var start = 0;
    var end = 0;

    fn Range(s, e) {
        this.start = s;
        this.end = e;
        return this;
    }

    fn _iter() {
        return RangeIter(this.start, this.end);
    }
}

class RangeIter {
    var current = 0;
    var end = 0;

    fn RangeIter(c, e) {
        this.current = c;
        this.end = e;
        return this;
    }

    fn _next() {
        if (this.current >= this.end) {
            return error(0);
        }
        var val = this.current;
        this.current = this.current + 1;
        return val;
    }
}

fn main() {
    var pass = 0;
    var fail = 0;

    // custom iterator via _iter/_next
    var sum = 0;
    var count = 0;
    for (i : Range(1, 6)) {
        sum = sum + i;
        count = count + 1;
    }
    if (sum == 15) { pass = pass + 1; } else { print("FAIL: custom iter sum\n"); fail = fail + 1; }
    if (count == 5) { pass = pass + 1; } else { print("FAIL: custom iter count\n"); fail = fail + 1; }

    // empty range
    count = 0;
    for (i : Range(0, 0)) {
        count = count + 1;
    }
    if (count == 0) { pass = pass + 1; } else { print("FAIL: custom iter empty\n"); fail = fail + 1; }

    // break in custom iterator
    sum = 0;
    for (i : Range(1, 100)) {
        if (i > 5) {
            break;
        }
        sum = sum + i;
    }
    if (sum == 15) { pass = pass + 1; } else { print("FAIL: custom iter break\n"); fail = fail + 1; }

    print("class_iter: ");
    print(pass);
    print("/");
    print(pass + fail);
    print(" passed\n");
    return 0;
}
