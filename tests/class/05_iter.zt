class Range {
    var start = 0;
    var end = 0;

    fn _init(s, e) {
        this.start = s;
        this.end = e;
        return this;
    }

    fn _iter() {
        return RangeIter(this.start, this.end);
    }
}

class RangeIter {
    var current = 0;
    var end = 0;

    fn _init(c, e) {
        this.current = c;
        this.end = e;
        return this;
    }

    fn _next() {
        if (this.current >= this.end) {
            return error(0);
        }
        var val = this.current;
        this.current = this.current + 1;
        return val;
    }
}

fn main() {
    // custom iterator via _iter/_next
    var sum = 0;
    var count = 0;
    for (i : Range(1, 6)) {
        sum = sum + i;
        count = count + 1;
    }
    assert(sum == 15);
    assert(count == 5);

    // empty range
    count = 0;
    for (i : Range(0, 0)) {
        count = count + 1;
    }
    assert(count == 0);

    // break in custom iterator
    sum = 0;
    for (i : Range(1, 100)) {
        if (i > 5) {
            break;
        }
        sum = sum + i;
    }
    assert(sum == 15);

    print("class_iter: all passed\n");
    return 0;
}
