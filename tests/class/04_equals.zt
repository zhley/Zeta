class Vec2 {
    var x = 0;
    var y = 0;

    fn _init(vx, vy) {
        this.x = vx;
        this.y = vy;
        return this;
    }

    fn _equals(other) {
        if (this.x == other.x && this.y == other.y) {
            return true;
        }
        return false;
    }

    fn add(other) {
        return Vec2(this.x + other.x, this.y + other.y);
    }
}

fn main() {
    // _equals: value equality
    var a = Vec2(1, 2);
    var b = Vec2(1, 2);
    var c = Vec2(3, 4);

    assert(a == b);
    assert(a != c);

    // is vs == on instances
    assert(!(a is b));
    assert(a is a);

    // _equals with modified values
    a.x = 10;
    assert(a != b);

    print("equals: all passed\n");
    return 0;
}
