class Vec2 {
    var x = 0;
    var y = 0;

    fn _init(vx, vy) {
        this.x = vx;
        this.y = vy;
        return this;
    }

    fn _equals(other) {
        if (this.x == other.x && this.y == other.y) {
            return true;
        }
        return false;
    }

    fn add(other) {
        return Vec2(this.x + other.x, this.y + other.y);
    }
}

fn main() {
    var pass = 0;
    var fail = 0;

    // _equals: value equality
    var a = Vec2(1, 2);
    var b = Vec2(1, 2);
    var c = Vec2(3, 4);

    if (a == b) { pass = pass + 1; } else { print("FAIL: _equals same values\n"); fail = fail + 1; }
    if (a != c) { pass = pass + 1; } else { print("FAIL: _equals different values\n"); fail = fail + 1; }

    // is vs == on instances
    if (!(a is b)) { pass = pass + 1; } else { print("FAIL: is different instances\n"); fail = fail + 1; }
    if (a is a) { pass = pass + 1; } else { print("FAIL: is same instance\n"); fail = fail + 1; }

    // _equals with modified values
    a.x = 10;
    if (a != b) { pass = pass + 1; } else { print("FAIL: _equals after modification\n"); fail = fail + 1; }

    print("equals: ");
    print(pass);
    print("/");
    print(pass + fail);
    print(" passed\n");
    return 0;
}
