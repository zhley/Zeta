class Animal {
    var name = "";

    fn _init(n) {
        this.name = n;
        return this;
    }

    fn speak() {
        return "Animal " + this.name;
    }
}

class Dog extends Animal {
    var breed = "";

    fn _init(n, b) {
        this.name = n;
        this.breed = b;
        return this;
    }

    fn speak() {
        return "Dog " + this.name + " (" + this.breed + ")";
    }
}

fn main() {
    // base class
    var a = Animal("Bob");
    assert(a.name == "Bob");
    assert(a.speak() == "Animal Bob");

    // derived class inherits fields
    var d = Dog("Rex", "Labrador");
    assert(d.name == "Rex");
    assert(d.breed == "Labrador");

    // method override
    assert(d.speak() == "Dog Rex (Labrador)");

    // base method still works on base instance
    assert(a.speak() == "Animal Bob");

    print("inheritance: all passed\n");
    return 0;
}
