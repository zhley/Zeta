class Point {
    var x = 0;
    var y = 0;

    fn set_x(val) {
        this.x = val;
        return this;
    }

    fn set_y(val) {
        this.y = val;
        return this;
    }
}

fn main() {
    // instantiation
    var p = Point();
    assert(p.x == 0 && p.y == 0);

    // field access and modification
    p.x = 10;
    p.y = 20;
    assert(p.x == 10 && p.y == 20);

    // method call
    p.set_x(30);
    assert(p.x == 30);

    p.set_y(40);
    assert(p.y == 40);

    // method chaining
    p.set_x(50).set_y(60);
    assert(p.x == 50 && p.y == 60);

    // two distinct instances
    var p1 = Point();
    var p2 = Point();
    p1.x = 100;
    p2.x = 200;
    assert(p1.x == 100 && p2.x == 200);

    print("class_basic: all passed\n");
    return 0;
}
