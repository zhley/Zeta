// super.method() calls: base constructor and base method invocation
//
// super 语义: 跳过当前方法所属的类, 从它的父类开始向上查找.
// 通过继承链调用时 (如 C 的实例调用 B 的方法), super 仍然从 B 的父类开始找.
// 要调用祖父类的方法也可以直接用类名调用: B.who(instance), 第一个参数是 this.

class Animal {
    var name = "";

    fn _init(n) {
        this.name = n;
        return this;
    }

    fn speak() {
        return "Animal " + this.name;
    }
}

class Dog extends Animal {
    var breed = "";

    fn _init(n, b) {
        super._init(n);
        this.breed = b;
        return this;
    }

    fn speak() {
        return "Dog " + this.name + " (" + this.breed + ")";
    }

    fn base_speak() {
        return super.speak();
    }
}

class A {
    var tag = "";

    fn _init() {
        this.tag = "A";
        return this;
    }

    fn who() {
        return "A";
    }
}

class B extends A {
    fn _init() {
        super._init();
        this.tag = this.tag + "B";
        return this;
    }

    fn who() {
        return "B+" + super.who();
    }
}

class C extends B {
    fn _init() {
        super._init();
        return this;
    }

    fn who() {
        return "C+" + super.who();
    }
}

fn main() {
    // super._init: base constructor runs before derived body
    var d = Dog("Rex", "Labrador");
    assert(d.name == "Rex");
    assert(d.breed == "Labrador");

    // super.method: invoke the overridden base method
    assert(d.base_speak() == "Animal Rex");

    // derived override still works
    assert(d.speak() == "Dog Rex (Labrador)");

    // base instance unaffected
    var a = Animal("Bob");
    assert(a.speak() == "Animal Bob");
    assert(a.name == "Bob");

    // three-level chain: every super resolves from the class the method is
    // defined in, so the whole constructor chain and override chain run
    var c = C();
    assert(c.tag == "AB");
    assert(c.who() == "C+B+A");

    // calling a method via class name: the first argument is 'this'
    assert(B.who(c) == "B+A");
    assert(A.who(c) == "A");

    print("super: all passed\n");
    return 0;
}
