fn main() {
    // integer arithmetic
    assert(1 + 1 == 2);
    assert(5 - 3 == 2);
    assert(3 * 4 == 12);
    assert(10 / 3 == 3);
    assert(10 % 3 == 1);
    assert(-5 == -5);
    assert(-(-5) == 5);

    // float arithmetic
    assert(1.5 + 2.5 == 4.0);
    assert(3.0 - 1.0 == 2.0);
    assert(2.0 * 3.0 == 6.0);
    assert(5.0 / 2.0 == 2.5);
    assert(-3.14 == -3.14);

    // mixed int/float (int promoted to float)
    assert(1 + 2.0 == 3.0);
    assert(3.0 - 1 == 2.0);
    assert(2 * 3.0 == 6.0);
    assert(5.0 / 2 == 2.5);

    print("arithmetic: all passed\n");
    return 0;
}
