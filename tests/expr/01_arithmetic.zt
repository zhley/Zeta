fn main() {
    var pass = 0;
    var fail = 0;

    // integer arithmetic
    if (1 + 1 == 2) { pass = pass + 1; } else { print("FAIL: int add\n"); fail = fail + 1; }
    if (5 - 3 == 2) { pass = pass + 1; } else { print("FAIL: int sub\n"); fail = fail + 1; }
    if (3 * 4 == 12) { pass = pass + 1; } else { print("FAIL: int mul\n"); fail = fail + 1; }
    if (10 / 3 == 3) { pass = pass + 1; } else { print("FAIL: int div (trunc)\n"); fail = fail + 1; }
    if (10 % 3 == 1) { pass = pass + 1; } else { print("FAIL: int mod\n"); fail = fail + 1; }
    if (-5 == -5) { pass = pass + 1; } else { print("FAIL: negate\n"); fail = fail + 1; }
    if (-(-5) == 5) { pass = pass + 1; } else { print("FAIL: double negate\n"); fail = fail + 1; }

    // float arithmetic
    if (1.5 + 2.5 == 4.0) { pass = pass + 1; } else { print("FAIL: float add\n"); fail = fail + 1; }
    if (3.0 - 1.0 == 2.0) { pass = pass + 1; } else { print("FAIL: float sub\n"); fail = fail + 1; }
    if (2.0 * 3.0 == 6.0) { pass = pass + 1; } else { print("FAIL: float mul\n"); fail = fail + 1; }
    if (5.0 / 2.0 == 2.5) { pass = pass + 1; } else { print("FAIL: float div\n"); fail = fail + 1; }
    if (-3.14 == -3.14) { pass = pass + 1; } else { print("FAIL: float negate\n"); fail = fail + 1; }

    // mixed int/float (int promoted to float)
    if (1 + 2.0 == 3.0) { pass = pass + 1; } else { print("FAIL: int+float\n"); fail = fail + 1; }
    if (3.0 - 1 == 2.0) { pass = pass + 1; } else { print("FAIL: float-int\n"); fail = fail + 1; }
    if (2 * 3.0 == 6.0) { pass = pass + 1; } else { print("FAIL: int*float\n"); fail = fail + 1; }
    if (5.0 / 2 == 2.5) { pass = pass + 1; } else { print("FAIL: float/int\n"); fail = fail + 1; }

    print("arithmetic: ");
    print(pass);
    print("/");
    print(pass + fail);
    print(" passed\n");
    return 0;
}
