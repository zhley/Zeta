fn main() {
    // bitwise AND
    assert(0xFF & 0x0F == 0x0F);
    assert(0 & 1 == 0);

    // bitwise OR
    assert(0xF0 | 0x0F == 0xFF);
    assert(0 | 0 == 0);

    // bitwise XOR
    assert(0xFF ^ 0xFF == 0);
    assert(0xF0 ^ 0x0F == 0xFF);

    // bitwise NOT
    assert(~0 == -1);
    assert(~~0 == 0);

    // shift left
    assert(1 << 0 == 1);
    assert(1 << 1 == 2);
    assert(1 << 8 == 256);

    // shift right
    assert(256 >> 8 == 1);
    assert(2 >> 1 == 1);
    assert(1 >> 0 == 1);

    print("bitwise: all passed\n");
    return 0;
}
