fn main() {
    // int comparisons
    assert(1 == 1);
    assert(1 != 2);
    assert(1 < 2);
    assert(2 > 1);
    assert(1 <= 1);
    assert(1 >= 1);

    // float comparisons
    assert(1.5 == 1.5);
    assert(1.0 != 2.0);
    assert(1.0 < 2.0);
    assert(2.0 > 1.0);
    assert(1.0 <= 1.0);
    assert(1.0 >= 1.0);

    // cross-type int/float
    assert(0 == 0.0);
    assert(1 == 1.0);
    assert(1.0 == 1);
    assert(2 != 3.0);
    assert(0 < 0.5);
    assert(1.5 > 1);

    // bool comparisons
    assert(true == true);
    assert(true != false);

    // null comparisons
    assert(null == null);
    assert(null != true);

    print("comparison: all passed\n");
    return 0;
}
