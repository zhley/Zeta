var flag = 1;

fn func(){
    flag += 1;
    return true;
}

fn truthy(v) {
    if (v) {
        return true;
    }
    return false;
}

fn main() {
    // AND truth table
    assert((true && true) == true);
    assert((true && false) == false);
    assert((false && true) == false);
    assert((false && false) == false);

    // OR truth table
    assert((true || true) == true);
    assert((true || false) == true);
    assert((false || true) == true);
    assert((false || false) == false);

    // NOT
    assert(!true == false);
    assert(!false == true);

    // short-circuit: func() must not be called
    assert(true || func());
    assert(!(false && func()));
    assert(flag == 1);

    // truthiness: non-bool operands work in condition context
    assert(truthy(1 && 1));
    assert(!truthy(0));
    assert(truthy(0 || "x"));

    // operand-returning semantics (same for constant folding and runtime):
    // && returns the left operand if falsy, else the right operand;
    // || returns the left operand if truthy, else the right operand.
    // the result keeps the operand's own type, not a Bool.
    assert((1 && 2) is 2);       // folded: Int 2, not Bool true
    assert((1 && 2) == 2);
    assert((0 && 2) == 0);
    assert((2 || 3) == 2);
    assert((0 || 3) == 3);
    assert(("a" && "b") == "b");
    assert(("" || "b") == "b");
    assert(("a" || "b") == "a");

    // runtime path (non-literal operands) matches the folded path
    var n = 1;
    assert((n && 2) is 2);
    assert((n && 2) == 2);
    assert((0 && n) == 0);
    assert((n || 2) == 1);
    assert((0 || n) == 1);

    print("logical: all passed\n");
    return 0;
}
