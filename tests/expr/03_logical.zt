var flag = 1;

fn func(){
    flag += 1;
    return true;
}

fn truthy(v) {
    if (v) {
        return true;
    }
    return false;
}

fn main() {
    // AND truth table
    assert((true && true) == true);
    assert((true && false) == false);
    assert((false && true) == false);
    assert((false && false) == false);

    // OR truth table
    assert((true || true) == true);
    assert((true || false) == true);
    assert((false || true) == true);
    assert((false || false) == false);

    // NOT
    assert(!true == false);
    assert(!false == true);

    // short-circuit: func() must not be called
    assert(true || func());
    assert(!(false && func()));
    assert(flag == 1);

    // truthiness: non-bool operands work in condition context
    assert(truthy(1 && 1));
    assert(!truthy(0));
    assert(truthy(0 || "x"));

    print("logical: all passed\n");
    return 0;
}
