fn main() {
    // string concatenation
    var s1 = "Hello, " + "World!";
    assert(s1 == "Hello, World!");

    // concatenation with empty string
    assert(("" + "x") == "x");
    assert(("x" + "") == "x");

    // multiple concatenation
    assert(("a" + "b" + "c") == "abc");

    // string comparison
    assert("abc" == "abc");
    assert("abc" != "xyz");

    // is operator on strings
    assert("foo" is "foo");
    // concatenated string vs literal: content same but types differ
    var cs = "a" + "b"; // constant fold => var cs = "ab"; so cs is still a interned string, not a String object
    assert(cs == "ab");
    assert(cs is "ab");
    var sobj = cs + "x";
    assert(sobj == "abx");
    assert(!(sobj is "abx"));

    // string length
    assert("".len() == 0);
    assert("hello".len() == 5);
    assert(("ab" + "c").len() == 3);

    print("string_ops: all passed\n");
    return 0;
}
