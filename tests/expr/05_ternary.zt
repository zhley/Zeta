fn main() {
    // basic ternary
    assert((true ? 1 : 2) == 1);
    assert((false ? 1 : 2) == 2);

    // nested ternary
    assert((true ? (false ? 1 : 2) : 3) == 2);

    // ternary with comparisons
    var score = 85;
    assert((score >= 60 ? "pass" : "fail") == "pass");

    // ternary returning different types
    assert((false ? 0 : 1.0) == 1.0);

    print("ternary: all passed\n");
    return 0;
}
