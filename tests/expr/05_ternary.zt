fn main() {
    var pass = 0;
    var fail = 0;

    // basic ternary
    if ((true ? 1 : 2) == 1) { pass = pass + 1; } else { print("FAIL: true ternary\n"); fail = fail + 1; }
    if ((false ? 1 : 2) == 2) { pass = pass + 1; } else { print("FAIL: false ternary\n"); fail = fail + 1; }

    // nested ternary
    if ((true ? (false ? 1 : 2) : 3) == 2) { pass = pass + 1; } else { print("FAIL: nested ternary\n"); fail = fail + 1; }

    // ternary with comparisons
    var score = 85;
    if ((score >= 60 ? "pass" : "fail") == "pass") { pass = pass + 1; } else { print("FAIL: ternary comp\n"); fail = fail + 1; }

    // ternary returning different types
    if ((false ? 0 : 1.0) == 1.0) { pass = pass + 1; } else { print("FAIL: ternary mixed types\n"); fail = fail + 1; }

    print("ternary: ");
    print(pass);
    print("/");
    print(pass + fail);
    print(" passed\n");
    return 0;
}
