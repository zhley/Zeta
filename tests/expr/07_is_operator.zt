fn main() {
    // is: strict identity (type + value/pointer)
    assert(42 is 42);
    assert(!(0 is 0.0));
    assert(true is true);
    assert(null is null);
    assert("s" is "s");

    // is vs == : different behavior
    // 0 == 0.0 is true (value equality across types)
    // 0 is 0.0 is false (strict identity differs)
    assert(0 == 0.0);
    assert(!(0 is 0.0));

    // is on objects
    var arr = [1, 2, 3];
    assert(arr is arr);
    assert(!(arr is [1, 2, 3]));

    print("is_operator: all passed\n");
    return 0;
}
