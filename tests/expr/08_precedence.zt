fn main() {
    // precedence: * before +
    assert(2 + 3 * 4 == 14);

    // precedence: comparison before logical
    assert(1 < 2 || 3 > 4 == true);

    // precedence: && before ||
    assert(false || true && false == false);

    // precedence: unary before binary
    assert(-3 + 5 == 2);
    assert(!false || false == true);

    // precedence: ternary is low
    // value must be 1 (then-branch), not (1 + 3) == 1
    assert((true ? 1 : 2 + 3 == 1) == 1);

    // parentheses override
    assert((2 + 3) * 4 == 20);

    // shift vs arithmetic precedence
    assert(1 << 1 + 1 == 4);

    print("precedence: all passed\n");
    return 0;
}
